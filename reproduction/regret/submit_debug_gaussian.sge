#!/bin/bash
# DEBUG pass, Gaussian rewards: the cheapest main case (sphere, d = 16, r = 1, rho = 0.5) at horizon 2000, 3
# replications, every arm: 45 cells, one per task (up to about half a minute each).  Checks the pipeline;
# makes no statistical claim (at 2000 rounds the environments are not those of the production cells).
# Then: python3 collect_regret.py gaussian --tiers debug --designs sphere --levels 0.5 --horizon 2000 --replications 3 --out debug_gaussian
#       python3 verdict_regret.py debug_gaussian
#$ -pe smp 1
#$ -q long
#$ -N debug_gaussian
#$ -t 1-45
#$ -tc 110
#$ -r n

module load python/3.12.15
cd $SGE_O_WORKDIR
python3 run_regret.py gaussian --tiers debug --designs sphere --levels 0.5 --horizon 2000 --replications 3 --out debug_gaussian --chunk $SGE_TASK_ID --chunks 45
