#!/bin/bash
# Inference experiment: blocks I1 (identity link, to 10,000 rounds), I2l
# (logistic, p_bar 0.8, to 60,000) and I1d32 (identity link, d = 32, to 10,000), each on two covariate laws, and I3
# (adaptive tie); B = 500 per block; 611 tasks (simulation.tasks()).  Four targets on every
# collection (I3: its main effect).
# The collection: tau by the regret study's rule at c_tau = 1/20, the penalty constant by 10-fold CV inside each track
# from 200 rows.  Steps 2-4 for every choice of n0 (simulation.N0_CHOICES: the design-stage split with cap 3/4,
# displayed; the information rule; the shares 0.1, 0.3, 0.5, 0.7, 0.9; no refit; the design-stage split with cap 0.9)
# and the rank arms, all on the same collections; every row also records the collection's regret and the target's
# Cramer-Rao standard error.
# Algorithm 2's refit at C_ref = 1/15 (algorithms.C_REF).  The information rule's kappa0 = tr(G_w)/(tau p) on the
# exploration, c0 = 1/3 in both splits;
# every collection is recorded in inference_results/records (seed, arms played, rewards, pilot, CV choices, kappa0,
# every arm's n0; about 0.4 GB), and replay_inference.py regenerates it from the seed.
# Submit:  JOBID=$(qsub -terse submit_inference.sge | cut -d. -f1); qsub -hold_jid $JOBID notify.sge
# A task writes its part after every replicate, so resubmitting finishes an interrupted plan.
# Then:    python3 collect_inference.py --regret-curves ../regret/regret_gaussian/collected/regret_curves.tsv,../regret/regret_binomial/collected/regret_curves.tsv
#          python3 figures_inference.py  (design_75, the displayed choice; also --arm info_rule etc.,
#                                         --target entry_max / entry_min / rank1)
#$ -pe smp 1
#$ -q long
#$ -N inference
#$ -t 1-611
#$ -tc 110
#$ -r n

module load python/3.12.15
cd $SGE_O_WORKDIR
python3 run_inference.py --chunk $SGE_TASK_ID --chunks 611
